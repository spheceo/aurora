{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "SHOPIFY_TOKEN",
    "SHOPIFY_DOMAIN",
    "RESEND_API_KEY",
    "ADMIN_NOTIFICATION_EMAIL",
    "EMAIL_SENDER_DOMAIN",
    "APP_URL",
    "DATABASE_URL",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD",
    "WORKOS_STAFF_ORG_ID",
    "WORKOS_REDIRECT_URI",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
